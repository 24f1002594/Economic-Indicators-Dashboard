APP_ENV=development
API_PREFIX=/api/v1

DATABASE_URL=postgresql://username:password@localhost:5432/database_name

JWT_SECRET_KEY=paste_your_generated_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

COLLECTOR_ENABLED=false 
COLLECTOR_INTERVAL_MINUTES=60
COLLECTOR_RUN_ON_STARTUP=true
NSE_BASE_URL=https://www.nseindia.com 
NSE_CACHE_SECONDS=300
NSE_USER_AGENT=EconomicIndicatorsDashboard/0.1 (development collector)
WORLD_BANK_BASE_URL=https://api.worldbank.org
WORLD_BANK_CACHE_SECONDS=21600
TRADE_BASE_URL=https://tradestat.commerce.gov.in
TRADE_CACHE_SECONDS=21600
TRADE_REFRESH_HOURS=24
GST_BASE_URL=https://www.gst.gov.in
GST_CACHE_SECONDS=21600
GST_REFRESH_HOURS=24
MOSPI_BASE_URL=https://www.mospi.gov.in
MOSPI_CPI_CACHE_SECONDS=21600
INFLATION_REFRESH_HOURS=24
EXPENDITURE_BASE_URL=https://www.indiabudget.gov.in
EXPENDITURE_CACHE_SECONDS=86400
EXPENDITURE_REFRESH_HOURS=168
REQUEST_TIMEOUT_SECONDS=15
